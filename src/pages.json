{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^HeaderBar$": "@/components/HeaderBar.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "未命名店铺",
        "h5": {
          "navigationStyle": "custom"
        },
        "mp-weixin": {
          "navigationStyle": "default"
        }
      }
    },
    {
      "path": "pages/orders/orders",
      "style": {
        "navigationBarTitleText": "未命名店铺",
        "h5": {
          "navigationStyle": "custom"
        },
        "mp-weixin": {
          "navigationStyle": "default"
        }
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "未命名店铺",
        "h5": {
          "navigationStyle": "custom"
        },
        "mp-weixin": {
          "navigationStyle": "default"
        }
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/token-login/token-login",
      "style": {
        "navigationBarTitleText": "令牌登录"
      }
    },
    {
      "path": "pages/wechat-auth/wechat-auth",
      "style": {
        "navigationBarTitleText": "微信授权"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "OrderEase点单系统",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#7d7e80",
    "selectedColor": "#1989fa",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/orders/orders",
        "iconPath": "static/tabbar/orders.png",
        "selectedIconPath": "static/tabbar/orders-active.png",
        "text": "订单"
      },
      {
        "pagePath": "pages/mine/mine",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png",
        "text": "我的"
      }
    ]
  }
}
