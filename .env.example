# ============================================
# 前端环境变量配置
# ============================================

# API 配置
# 后端服务器基础URL，末尾需要带斜杠
VITE_API_BASE_URL=http://127.0.0.1:8080/

# API接口前缀，不需要开头斜杠
VITE_API_PREFIX=api/order-ease/v1

# 微信小程序配置
# 从微信公众平台获取: https://mp.weixin.qq.com/
# 开发管理 -> 开发设置 -> AppID(小程序ID)
VITE_MP_WEIXIN_APP_ID=your_appid_here

# ============================================
# ⚠️ 安全提示
# ============================================
# AppSecret 绝对不能配置在此文件中！
# AppSecret 应该配置在后端服务器的配置文件中
# 后端配置示例：
#   thirdparty:
#     wechat:
#       miniprogram:
#         app_id: "wx..."
#         app_secret: "..."  # <-- 仅后端配置
# ============================================

# ============================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 修改上述配置值为实际值
# 3. 重新构建项目: npm run build:mp-weixin
# ============================================
